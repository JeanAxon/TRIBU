{
  "name": "tribu-sri",
  "version": "0.1.0-alpha",
  "description": "Mini-navegador y gestor de clientes para automatización del SRI Ecuador",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/testApp.js && node test/testAtsAndParser.js && node test/testDiscapacidadIva.js && electron test/testClientManager.js && electron test/testSecurityModule.js && electron test/testDuplicateProtocol.js && electron test/test_electron_dom.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "dist:portable": "electron-builder --win portable"
  },
  "keywords": [
    "sri",
    "ecuador",
    "contabilidad",
    "electron",
    "automatizacion",
    "facturas"
  ],
  "author": "TRIBU",
  "license": "ISC",
  "build": {
    "appId": "com.tribu.sri",
    "productName": "TRIBU",
    "copyright": "Copyright © 2026 TRIBU",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TRIBU - Asistente SRI",
      "uninstallDisplayName": "TRIBU - Asistente Contable SRI",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0"
  }
}
