{
  "name": "tribu-sri",
  "version": "0.1.5",
  "description": "Mini-navegador y gestor de clientes para automatización del SRI Ecuador",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/testApp.js && node test/testAtsAndParser.js && node test/testDiscapacidadIva.js && electron test/testClientManager.js && electron test/testSecurityModule.js && electron test/testDuplicateProtocol.js && electron test/test_electron_dom.js",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:all": "electron-builder -mw",
    "dist:dir": "electron-builder --win --dir",
    "dist:portable": "electron-builder --win portable"
  },
  "keywords": [
    "sri",
    "ecuador",
    "contabilidad",
    "electron",
    "automatizacion",
    "facturas"
  ],
  "author": "TRIBU",
  "license": "ISC",
  "build": {
    "appId": "com.tribu.sri",
    "productName": "TRIBU",
    "copyright": "Copyright © 2026 TRIBU",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JeanAxon",
        "repo": "TRIBU"
      }
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.finance",
      "minimumSystemVersion": "11.0",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal",
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal",
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "icon": "assets/icon.icns",
      "iconSize": 128,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TRIBU - Asistente SRI",
      "uninstallDisplayName": "TRIBU - Asistente Contable SRI",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.18.0",
    "png2icons": "^2.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.12.0"
  }
}
